generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  FACULTY
  FACULTY_ADVISOR
  IEEE_COUNSELOR
  FACULTY_MEMBER
  CHAIRMAN
  VICE_CHAIRMAN
  JOINT_SECRETARY
  WEBMASTER
  PHOTOGRAPHER
  TREASURER
}

enum BranchPosition {
  IEEE_COUNSELOR
  FACULTY_MEMBER
  CHAIRMAN
  VICE_CHAIRMAN
  JOINT_SECRETARY
  WEBMASTER
  PHOTOGRAPHER
  TREASURER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
}

enum Visibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventAccess {
  PUBLIC
  UNIVERSITY
  MEMBERS_ONLY
  INVITE_ONLY
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  ABSENT
  WAITLISTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventRegistrationTemplate {
  UNIVERSITY_INDIVIDUAL
  UNIVERSITY_TEAM
  INTER_UNIVERSITY_INDIVIDUAL
  INTER_UNIVERSITY_TEAM
  PUBLIC_INDIVIDUAL
  PUBLIC_TEAM
  CUSTOM
}

enum EventParticipationType {
  INDIVIDUAL
  TEAM
}

enum EventFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EventFormFieldType {
  SHORT_ANSWER
  PARAGRAPH
  EMAIL
  PHONE
  NUMBER
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  DATE
  TIME
  FILE_UPLOAD
  IMAGE_UPLOAD
}

enum EventFormFieldScope {
  PARTICIPANT
  TEAM
}

enum NotificationType {
  EVENT
  ANNOUNCEMENT
  APPROVAL
  MEMBERSHIP
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  PUBLISH
  CANCEL
  REGISTER
  ATTEND
}

model User {
  id String @id @default(cuid())

  email     String  @unique
  password  String
  firstName String
  lastName  String?
  phone     String?

  role     UserRole @default(STUDENT)
  isActive Boolean  @default(true)

  ieeeMembershipNumber String? @unique

  profileImage             String?
  profileImageCloudinaryId String?
  bio                      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberProfile MemberProfile?

  leadershipPositions BranchLeadership[]

  eventRegistrations EventRegistration[]

  createdEvents Event[] @relation("EventCreator")

  announcementsCreated Announcement[] @relation("AnnouncementCreator")

  notifications Notification[]

  auditLogs AuditLog[]
}

model MemberProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipStatus MembershipStatus @default(PENDING)

  joinedAt DateTime?

  department String?
  course     String?
  year       String?
  rollNumber String?

  profileVisibility Visibility @default(MEMBERS_ONLY)

  approvedById String?
  approvedAt   DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id String @id @default(cuid())

  name      String   @unique
  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  leadershipPositions BranchLeadership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchLeadership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  position BranchPosition

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  startDate DateTime?
  endDate   DateTime?

  isCurrent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([position, academicYearId])
  @@index([userId])
  @@index([academicYearId])
}

model Event {
  id String @id @default(cuid())

  title            String
  slug             String  @unique
  shortDescription String?
  description      String
  bannerImage      String?
  venue            String?

  eventDate            DateTime
  startTime            DateTime?
  endTime              DateTime?
  registrationDeadline DateTime?

  capacity Int?

  status     EventStatus @default(DRAFT)
  access     EventAccess @default(PUBLIC)
  isFeatured Boolean     @default(false)

  registrationTemplate EventRegistrationTemplate?
  participationType    EventParticipationType     @default(INDIVIDUAL)
  minTeamSize          Int?
  maxTeamSize          Int?

  enableQrAttendance Boolean @default(false)

  createdById String
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id])

  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  registrationForm EventForm?
  registrations    EventRegistration[]
  teams            EventTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([eventDate])
  @@index([createdById])
  @@index([registrationTemplate])
}

model EventRegistration {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  teamId String?
  team   EventTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String?

  qrToken String? @unique

  isTeamLeader Boolean @default(false)

  registrationStatus RegistrationStatus @default(REGISTERED)

  registeredAt DateTime  @default(now())
  attendedAt   DateTime?

  formResponse EventFormResponse?

  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@index([teamId])
  @@index([registrationStatus])
}

model EventForm {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?

  template EventRegistrationTemplate?
  status   EventFormStatus            @default(DRAFT)

  fields    EventFormField[]
  responses EventFormResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventFormField {
  id String @id @default(cuid())

  formId String
  form   EventForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  key         String
  label       String
  description String?

  type  EventFormFieldType
  scope EventFormFieldScope @default(PARTICIPANT)

  required Boolean @default(false)

  placeholder String?

  options    Json?
  validation Json?

  order Int

  isSystemField Boolean @default(false)

  answers EventFormAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, key])
  @@index([formId, order])
}

model EventFormResponse {
  id String @id @default(cuid())

  formId String
  form   EventForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  registrationId String            @unique
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers EventFormAnswer[]

  @@index([formId])
  @@index([submittedAt])
}

model EventFormAnswer {
  id String @id @default(cuid())

  responseId String
  response   EventFormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  fieldId String
  field   EventFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([responseId, fieldId])
  @@index([fieldId])
}

model EventTeam {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name String

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

model Announcement {
  id String @id @default(cuid())

  title   String
  content String

  imageUrl String?

  visibility Visibility @default(PUBLIC)

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdById String
  createdBy   User   @relation("AnnouncementCreator", fields: [createdById], references: [id])

  approvalStatus ApprovalStatus @default(PENDING)

  approvedById String?
  approvedAt   DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([approvalStatus])
}

model GalleryAlbum {
  id String @id @default(cuid())

  title       String
  description String?

  coverImage        String?
  coverCloudinaryId String?

  visibility Visibility @default(PUBLIC)

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id String @id @default(cuid())

  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  imageUrl     String
  cloudinaryId String
  caption      String?

  createdAt DateTime @default(now())

  @@index([albumId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String
  entityId   String?

  description String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
